{
  "name": "@relocateit/database",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "prisma:migrate:deploy": "node --env-file=../../.env ../../node_modules/prisma/build/index.js migrate deploy --schema prisma/schema.prisma",
    "prisma:generate": "node --env-file=../../.env ../../node_modules/prisma/build/index.js generate --schema prisma/schema.prisma",
    "prisma:seed": "node --env-file=../../.env --experimental-strip-types prisma/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "typescript": "^5.8.0"
  }
}
