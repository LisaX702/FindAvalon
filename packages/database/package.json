{
  "name": "@relocateit/database",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "prisma:migrate:deploy": "node ./scripts/run-with-optional-env.mjs prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:generate": "node ./scripts/run-with-optional-env.mjs prisma generate --schema prisma/schema.prisma",
    "prisma:seed": "node ./scripts/run-with-optional-env.mjs seed",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "typescript": "^5.8.0"
  }
}
