# Hosted deployment example
# Do not copy local localhost values into Render.
# Render should supply DATABASE_URL for the API service from the managed Postgres instance.
# Render should also supply PORT automatically for each web service.

# Web service env
NEXT_PUBLIC_API_URL="https://relocateit-api.onrender.com"

# API service env
APP_URL="https://relocateit-web.onrender.com"

# Optional auth overrides
# Defaults for https-hosted APP_URL:
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAME_SITE=none
# SESSION_COOKIE_SECURE="true"
# SESSION_COOKIE_SAME_SITE="none"

# Managed by Render at deploy time
# DATABASE_URL="<managed by Render>"
# PORT="<managed by Render>"
